  "$id": "https://english-tutor.local/schemas/assessment-result/1.0.0",
  "title": "AssessmentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overallLevel",
    "skills",
    "strengths",
    "priorities",
    "confidence",
    "summaryZh"
