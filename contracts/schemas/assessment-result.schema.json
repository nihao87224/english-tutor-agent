          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "level",
            "confidence",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "level": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence": {
              "type": "array",
