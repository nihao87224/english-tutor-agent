# Application
APP_ENV=local
APP_TIMEZONE=Asia/Singapore
SERVER_PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_tutor
DB_USERNAME=english_tutor
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password
FLYWAY_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=english-tutor-local
S3_ACCESS_KEY=english_tutor
S3_SECRET_KEY=change_me_now
S3_PUBLIC_BASE_URL=http://localhost:9000/english-tutor-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=english_tutor
MINIO_ROOT_PASSWORD=change_me_now

# AI providers
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

ASR_PROVIDER=fake
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

TTS_PROVIDER=fake
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Privacy and retention
SAVE_RAW_TEXT_DEFAULT=true
SAVE_RAW_AUDIO_DEFAULT=false
RAW_AUDIO_RETENTION_DAYS=7

# Android local development
ANDROID_API_BASE_URL=http://10.0.2.2:8080
