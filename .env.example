# Application
APP_ENV=local
APP_TIMEZONE=Asia/Singapore
SERVER_PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_tutor
DB_USERNAME=english_tutor
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password
FLYWAY_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=english-tutor-local
S3_ACCESS_KEY=english_tutor
S3_SECRET_KEY=change_me_now
S3_PUBLIC_BASE_URL=http://localhost:9000/english-tutor-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=english_tutor
MINIO_ROOT_PASSWORD=change_me_now

# AI provider encryption. Configure all provider endpoints, models and API keys
# through Admin -> AI Provider Management; API keys are encrypted in MySQL.

# Auth / SaaS Foundation
TUTOR_JWT_SIGNING_SECRET=
TUTOR_SECRET_ENCRYPTION_KEY=
TUTOR_SECRET_ENCRYPTION_KEY_VERSION=v1
TUTOR_ACCESS_TOKEN_TTL=15m
TUTOR_BOOTSTRAP_ADMIN_ENABLED=false
TUTOR_BOOTSTRAP_ADMIN_EMAIL=
TUTOR_BOOTSTRAP_ADMIN_PASSWORD=
TUTOR_QUOTA_DEFAULT_DAILY_LIMIT=50
TUTOR_QUOTA_RESET_TIMEZONE=Asia/Shanghai
TUTOR_MEDIA_PUBLIC_BASE_URL=https://cdn.example.invalid/learning-content
TUTOR_MEDIA_PRIVATE_GATEWAY_BASE_URL=https://media.example.invalid/access
TUTOR_MEDIA_ACCESS_SIGNING_SECRET=
TUTOR_MEDIA_ACCESS_TTL=10m

# Privacy and retention
SAVE_RAW_TEXT_DEFAULT=true
SAVE_RAW_AUDIO_DEFAULT=false
RAW_AUDIO_RETENTION_DAYS=7

# Android local development
ANDROID_API_BASE_URL=http://10.0.2.2:8080
