# English Tutor Agent production environment template.
# Copy this file to a secure location, fill blanks, chmod 600 it, and never commit real secrets.

# Public web origin. Used by deployment scripts and Nginx templates.
APP_DOMAIN=
PUBLIC_BASE_URL=

# Application runtime.
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
SERVER_PORT=8080

# Web build API base URL.
# Leave empty for same-origin Nginx proxying, so the browser calls /api/v1/* on the current domain.
# If you intentionally deploy API on a separate origin, set a full URL and add backend CORS support first.
VITE_API_BASE_URL=

# MySQL.
# Required. Use a dedicated least-privilege user.
DB_HOST=
DB_PORT=3306
DB_NAME=english_tutor
DB_USERNAME=
DB_PASSWORD=
FLYWAY_ENABLED=true

# Optional exact JDBC override.
# Use only when your provider requires custom flags. If set, Spring Boot uses these instead of DB_HOST/DB_PORT.
# Do not leave these uncommented with empty values in production.
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Redis.
# Required for production deployments once Redis-backed features are enabled.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# S3-compatible object storage.
# Keep bucket private unless a reviewed public-read flow is required.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# AI providers.
# Current M3 deployment should normally keep fake providers.
# Replace only after a real provider adapter exists and has passed review.
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

ASR_PROVIDER=fake
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

TTS_PROVIDER=fake
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Privacy and retention defaults.
SAVE_RAW_TEXT_DEFAULT=true
SAVE_RAW_AUDIO_DEFAULT=false
RAW_AUDIO_RETENTION_DAYS=7
