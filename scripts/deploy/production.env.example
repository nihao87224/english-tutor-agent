# English Tutor Agent production environment template.
# Copy this file to a secure location, fill blanks, chmod 600 it, and never commit real secrets.

# Public web origin. Used by deployment scripts and Nginx templates.
APP_DOMAIN=
PUBLIC_BASE_URL=

# Application runtime.
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
SERVER_PORT=8080
# Host port exposed by Docker Compose on 127.0.0.1.
BACKEND_HOST_PORT=8080

# Web build API base URL.
# Leave empty for same-origin Nginx proxying, so the browser calls /api/v1/* on the current domain.
# If you intentionally deploy API on a separate origin, set a full URL and add backend CORS support first.
VITE_API_BASE_URL=

# MySQL.
# Required. Use a dedicated least-privilege user.
DB_HOST=
DB_PORT=3306
DB_NAME=english_tutor
DB_USERNAME=
DB_PASSWORD=
FLYWAY_ENABLED=true

# Optional exact JDBC override.
# Use only when your provider requires custom flags. If set, Spring Boot uses these instead of DB_HOST/DB_PORT.
# Do not leave these uncommented with empty values in production.
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Redis.
# Required for production deployments once Redis-backed features are enabled.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# S3-compatible object storage.
# Keep bucket private unless a reviewed public-read flow is required.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# AI providers.
# Required. Keep secrets only in the VPS environment file.
LLM_PROVIDER=openai
ASR_PROVIDER=openai
TTS_PROVIDER=openai

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TIMEOUT=30s

OPENAI_LLM_MODEL=
OPENAI_ASR_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# Auth / SaaS Foundation
TUTOR_JWT_SIGNING_SECRET=
TUTOR_SECRET_ENCRYPTION_KEY=
TUTOR_SECRET_ENCRYPTION_KEY_VERSION=v1
TUTOR_ACCESS_TOKEN_TTL=15m
TUTOR_AUTH_LEGACY_USER_KEY_ENABLED=false
TUTOR_BOOTSTRAP_ADMIN_ENABLED=false
TUTOR_BOOTSTRAP_ADMIN_EMAIL=
TUTOR_BOOTSTRAP_ADMIN_PASSWORD=
TUTOR_QUOTA_DEFAULT_DAILY_LIMIT=50
TUTOR_QUOTA_RESET_TIMEZONE=Asia/Shanghai

# Privacy and retention defaults.
SAVE_RAW_TEXT_DEFAULT=true
SAVE_RAW_AUDIO_DEFAULT=false
RAW_AUDIO_RETENTION_DAYS=7
